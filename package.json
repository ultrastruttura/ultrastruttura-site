{
  "name": "ultrastruttura-sito",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:open": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next build",
    "deploy": "next build && echo 'Build completato! Ora puoi fare push della cartella out/ su GitHub Pages'",
    "test": "npm run dev",
    "preview": "npm run build && npx serve out",
    "preview:open": "powershell -ExecutionPolicy Bypass -File ./preview-open.ps1",
    "serve": "npx serve out",
    "migrate:images": "node scripts/migrate-artwork-images.js",
    "cleanup:images": "node scripts/cleanup-artwork-duplicates.js"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "sharp": "^0.33.5",
    "typescript": "^5.5.4"
  }
}
